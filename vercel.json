{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "rewrites": [
    {
      "source": "/studio/:sti*",
      "destination": "/studio/index.html"
    },
    {
      "source": "/static/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/static/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/static/apple-touch-icon.png",
      "destination": "/apple-touch-icon.png"
    },
    {
      "source": "/static/manifest.webmanifest",
      "destination": "/studio/static/manifest.webmanifest"
    },
    {
      "source": "/fnugg/logo.svg",
      "destination": "https://fnugg.no/content/uploads/2015/10/Fnugg_logotype_horizontal_Pantone_306U.svg"
    }
  ],
  "headers": [
    {
      "source": "/studio/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/instagram",
      "destination": "/?utm_source=instagram&utm_medium=social",
      "permanent": false
    },
    {
      "source": "/instagram/",
      "destination": "/?utm_source=instagram&utm_medium=social",
      "permanent": false
    }
  ]
}
