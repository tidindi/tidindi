---
// Video i artikkelen. Rekkefølge ved avspilling (når «Vis Tidindi-vignett og sluttmerke» er på):
//   1. Vignett (1,3 s): den gotiske T-en, så ordmerket, sort på neongul flate.
//   2. Selve videoen i sort-hvitt, med tittel og byline nede i bildet de første sekundene, og teksting.
//   3. Sluttmerket (2 s): sort sirkel med neongul T på neongul flate.
// Ingen eksterne spillere eller sporing: vanlig <video> med filen fra Sanity.
import { bildeUrl } from '../data/innhold';
import { seksjonsnavn } from '../data/seksjoner';
import type { Bildedata, Videodata } from '../data/testinnhold';

interface Props {
  video: Videodata;
  reserveplakat?: Bildedata; // hovedbildet brukes som stillbilde når videoen ikke har eget
  plassering: 'topp' | 'tekst';
  seksjon?: string;
}
const { video, reserveplakat, plassering, seksjon } = Astro.props;
const forhold = video.staende ? 16 / 9 : 9 / 16;
const plakatbilde = video.plakat ?? reserveplakat;
const plakat = plakatbilde ? bildeUrl(plakatbilde, video.staende ? 720 : 1600, forhold) : undefined;
const s = video.staende ? '-staende' : '';
const vignett = video.vignett ? `/video/tidindi-vignett${s}.mp4` : '';
const sluttmerke = video.vignett ? `/video/tidindi-sluttmerke${s}.mp4` : '';
const teksting = video.teksting ? `data:text/vtt;charset=utf-8,${encodeURIComponent(video.teksting)}` : undefined;
const harTittel = !!(video.tittel || video.byline);
---
<figure class:list={['video-blokk', `video-${plassering}`]}>
  <div class:list={['video-ramme', { staende: video.staende }]}>
    <video
      class:list={['tidindi-video', 'gra']}
      src={video.url}
      poster={plakat}
      data-hoved={video.url}
      data-vignett={vignett}
      data-sluttmerke={sluttmerke}
      controls
      playsinline
      preload="metadata"
    >
      {teksting && <track kind="subtitles" srclang="nb" label="Norsk" src={teksting} default />}
      <a href={video.url}>Last ned videoen</a>
    </video>
    {harTittel && (
      <div class="video-tittel" aria-hidden="true">
        {seksjon && <p class="vt-merke"><span class="vt-rombe"></span>{seksjonsnavn(seksjon)}</p>}
        {video.tittel && <p class="vt-tittel">{video.tittel}</p>}
        {video.byline && <p class="vt-byline">{video.byline}</p>}
      </div>
    )}
  </div>
  {(video.tekst || video.kreditering) && (
    <figcaption>{video.tekst} {video.kreditering && <span class="meta">Video: {video.kreditering}</span>}</figcaption>
  )}
</figure>

<script is:inline>
  (function () {
    if (window.__tidindiVideo) return;
    window.__tidindiVideo = true;
    var start = function () {
      document.querySelectorAll('video.tidindi-video').forEach(function (v) {
        var d = v.dataset, ramme = v.parentNode, fase = 'klar', tittelTimer;
        var spor = function (vis) { for (var i = 0; i < v.textTracks.length; i++) v.textTracks[i].mode = vis ? 'showing' : 'hidden'; };
        var bytt = function (src, gra) { v.src = src; v.classList.toggle('gra', gra); v.play().catch(function () {}); };
        var hoved = function () {
          fase = 'hoved'; spor(true);
          if (v.currentSrc.indexOf(d.hoved) === -1) bytt(d.hoved, true);
          ramme.classList.add('vis-tittel');
          clearTimeout(tittelTimer);
          tittelTimer = setTimeout(function () { ramme.classList.remove('vis-tittel'); }, 5000);
        };
        v.addEventListener('play', function () {
          if (fase !== 'klar') return;
          if (d.vignett) { fase = 'inn'; spor(false); bytt(d.vignett, false); } else hoved();
        });
        v.addEventListener('ended', function () {
          if (fase === 'inn') hoved();
          else if (fase === 'hoved' && d.sluttmerke) { fase = 'ut'; spor(false); ramme.classList.remove('vis-tittel'); bytt(d.sluttmerke, false); }
          else if (fase === 'ut' || fase === 'hoved') {
            // Ferdig: tilbake til stillbildet, klar til å spilles på nytt.
            fase = 'klar'; v.src = d.hoved; v.classList.add('gra'); spor(true);
          }
        });
      });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
  })();
</script>

<style>
  .video-blokk { display: flex; flex-direction: column; gap: var(--s2); }
  .video-tekst { margin: var(--s2) 0; }
  .video-ramme { position: relative; background: var(--kull); aspect-ratio: 16 / 9; width: 100%; }
  .video-ramme.staende { aspect-ratio: 9 / 16; width: min(100%, 420px); }
  .video-tekst .video-ramme.staende { width: min(100%, 360px); }
  .tidindi-video { display: block; width: 100%; height: 100%; object-fit: contain; background: var(--kull); }
  .tidindi-video.gra { filter: grayscale(1); }
  .tidindi-video::cue { font-family: 'Source Serif 4', Georgia, serif; color: #F5F4EF; background: rgba(28, 30, 32, 0.86); }

  /* Tittel og byline nede i bildet de første sekundene av selve videoen */
  .video-tittel {
    position: absolute; left: 4%; bottom: 26%; max-width: 70%;
    background: var(--kull); color: var(--blyhvit); padding: 12px 16px 13px;
    display: flex; flex-direction: column; gap: 4px;
    opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; pointer-events: none;
  }
  .staende .video-tittel { max-width: 88%; bottom: 28%; }
  .vis-tittel .video-tittel { opacity: 1; transform: none; }
  .video-tittel p { margin: 0; }
  .vt-merke { display: flex; align-items: center; gap: 8px; font-family: var(--etikett); font-weight: 600; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--neon); }
  .vt-rombe { width: 7px; height: 7px; background: var(--neon); transform: rotate(45deg); }
  .vt-tittel { font-family: var(--overskrift); font-weight: 700; font-size: clamp(17px, 2.2vw, 24px); line-height: 1.15; }
  .vt-byline { font-family: var(--etikett); font-weight: 600; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #A9ADB3; }
  figcaption { font-size: 15px; line-height: 1.45; color: var(--tekst-2); }
</style>
