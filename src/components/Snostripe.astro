---
// Stripe med skiføret fra fnugg.no på forsiden.
// Dataene hentes i nettleseren fra /api/fnugg (Vercel-funksjon med 15 minutters mellomlagring).
// Stripen er skjult til dataene er på plass, og forblir skjult utenfor sesongen eller hvis
// fnugg ikke svarer. Krediteringen følger fnuggs vilkår: godt synlig, i samme størrelse som
// teksten ellers, med logo og lenke. Logoen hentes uendret via /fnugg/fnugg-logo.svg (vercel.json).
//
// Bilde (Oles eget, tatt i Raudalen mot Beitostølen, i farger, uten fotokreditt etter Oles ønske): variant «bakgrunn» legger det
// dust bak hele seksjonen, variant «stripe» viser det som et panoramafelt øverst.
interface Props { variant?: 'bakgrunn' | 'stripe' }
const { variant = 'bakgrunn' } = Astro.props;
const FOTO = 'Fra Raudalen, mot Beitostølen';
---
<section class={`sno sno--${variant} strek-tykk`} aria-labelledby="sno-tittel" hidden data-sno>
  <figure class="sno-bilde" aria-hidden="true">
    <img src="/bilder/raudalen-stripe.webp" alt="" width="1580" height="316" decoding="async" />
  </figure>
  <p class="sno-foto">{FOTO}</p>
  <div class="sno-topp">
    <h2 id="sno-tittel" class="etikett sno-fane"><span class="rombe" aria-hidden="true"></span>Skiføret nå</h2>
    <div class="sno-hode">
      <div>
        <p class="sno-antall" data-sno-antall></p>
        <p class="sno-under" data-sno-under></p>
      </div>
    </div>
  </div>

  <ul class="sno-liste" data-sno-liste></ul>

  <div class="sno-kilde">
    <a class="sno-logo" href="https://fnugg.no/" aria-label="fnugg.no">
      <img src="/fnugg/fnugg-logo.svg" alt="fnugg" width="86" height="32" decoding="async" />
    </a>
    <p>
      <a href="https://fnugg.no/">Vær- og føredata er levert av fnugg, Yr, Meteorologisk institutt og NRK</a><span data-sno-tid></span>
    </p>
    <div class="sno-piler" data-sno-piler hidden>
      <button type="button" class="sno-pil" data-sno-pil="-1" aria-label="Forrige anlegg"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M19 12H6M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter"/></svg></button>
      <button type="button" class="sno-pil" data-sno-pil="1" aria-label="Neste anlegg"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter"/></svg></button>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const stripe = document.querySelector('[data-sno]');
    if (!stripe) return;
    const tidFmt = new Intl.DateTimeFormat('nb-NO', { timeZone: 'Europe/Oslo', hour: '2-digit', minute: '2-digit' });
    const lag = (tag, klasse, tekst) => {
      const el = document.createElement(tag);
      if (klasse) el.className = klasse;
      if (tekst != null) el.textContent = tekst;
      return el;
    };
    const av = (o) => (o && o.apne != null && o.totalt ? `${o.apne}\u00a0av\u00a0${o.totalt}` : null);

    const datoFmt = new Intl.DateTimeFormat('nb-NO', { timeZone: 'UTC', day: 'numeric', month: 'short' });
    const dagFmt = new Intl.DateTimeFormat('nb-NO', { timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'long' });
    const nbsp = (t) => t.replace(/(\d+\.) /g, '$1\u00a0');
    // Kortet: etikett (status · region) → navn → én linje brødtekst. Ingen store tall.
    const kort = (a, apent) => {
      const li = lag('li', 'sno-anlegg');
      const lenke = lag('a', 'sno-kort');
      lenke.href = a.lenke;
      const status = apent ? 'Åpent' : `Åpner ${nbsp(datoFmt.format(new Date(a.apner)))}`;
      const etikett = lag('span', 'meta sno-status');
      etikett.append(lag('span', apent ? 'sno-prikk sno-prikk--apen' : 'sno-prikk'), status);
      lenke.append(etikett, lag('span', 'sno-navn', a.navn));
      lenke.append(lag('span', 'meta sno-region', a.region || '\u00a0')); // tom linje når region mangler, så kortene står på linje
      let linje;
      if (apent) {
        const deler = [];
        if (a.snoBakke > 0) deler.push(`${a.snoBakke}\u00a0cm snø i bakken`);
        const ap = [];
        if (av(a.heiser)) ap.push(`${av(a.heiser)} heiser`);
        if (av(a.bakker)) ap.push(`${av(a.bakker)} bakker`);
        if (ap.length) deler.push(`${ap.join(' og ')} åpne`);
        linje = deler.length ? deler.join(', ') + '.' : 'Åpent i dag.';
        linje = linje.charAt(0).toUpperCase() + linje.slice(1);
      } else {
        const d = dagFmt.format(new Date(a.apner));
        linje = `Sesongstart ${nbsp(d)}.`;
      }
      lenke.append(lag('span', 'sno-linje', linje));
      li.append(lenke);
      return li;
    };

    fetch('/api/fnugg', { headers: { Accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : null))
      .then((data) => {
        if (!data) return;
        const apne = Array.isArray(data.apne) ? data.apne : [];
        const snart = Array.isArray(data.snart) ? data.snart : [];
        if (apne.length === 0 && snart.length === 0) return;
        const liste = stripe.querySelector('[data-sno-liste]');
        // Hele oversikten fra fnugg: alle åpne (mest snø først), så alle som åpner snart (nærmeste først)
        apne.forEach((a) => liste.append(kort(a, true)));
        snart.forEach((a) => liste.append(kort(a, false)));

        const n = apne.length;
        const ORD = ['Ingen', 'Ett', 'To', 'Tre', 'Fire', 'Fem', 'Seks', 'Sju', 'Åtte', 'Ni', 'Ti'];
        const antall = n < ORD.length ? ORD[n] : String(n);
        stripe.querySelector('[data-sno-antall]').textContent =
          n === 0 ? 'Ingen skianlegg har åpnet ennå' : `${antall} skianlegg har åpent nå`;
        const m = snart.length;
        const ord = (x) => (x < ORD.length ? ORD[x].toLowerCase() : String(x));
        if (m > 0) stripe.querySelector('[data-sno-under]').textContent =
          n > 0 ? `Ytterligere ${ord(m)} åpner i ukene som kommer.` : `${ord(m).replace(/^./, (c) => c.toUpperCase())} åpner i ukene som kommer.`;
        if (data.oppdatert) {
          const d = new Date(data.oppdatert);
          if (!isNaN(d)) stripe.querySelector('[data-sno-tid]').textContent = `. Sist oppdatert kl. ${tidFmt.format(d).replace(':', '.')}.`;
        }
        stripe.hidden = false;

        // Piler på PC når raden er bredere enn plassen
        const piler = stripe.querySelector('[data-sno-piler]');
        const knapper = piler.querySelectorAll('[data-sno-pil]');
        const oppdaterPiler = () => {
          const maks = liste.scrollWidth - liste.clientWidth;
          piler.hidden = maks < 4;
          knapper[0].disabled = liste.scrollLeft <= 2;
          knapper[1].disabled = liste.scrollLeft >= maks - 2;
        };
        knapper.forEach((k) => k.addEventListener('click', () => {
          liste.scrollBy({ left: Number(k.dataset.snoPil) * liste.clientWidth * 0.9, behavior: 'smooth' });
        }));
        liste.addEventListener('scroll', oppdaterPiler, { passive: true });
        window.addEventListener('resize', oppdaterPiler);
        oppdaterPiler();
      })
      .catch(() => {});
  })();
</script>

<style is:global>
  /* Global fordi kortene lages i nettleseren og ikke får Astros avgrensede klasser. Alle klasser har prefikset sno-. */
  .sno { display: flex; flex-direction: column; gap: var(--s4); }
  .sno.strek-tykk { padding-top: 0; position: relative; --sno-pad: var(--gutter); }
  .sno-foto {
    font-family: var(--etikett); font-weight: 600; font-size: 12px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--tekst-2);
  }

  /* Variant 1: dus bakgrunn bak hele seksjonen (bildet i farger, blyhvitt slør over) */
  .sno--bakgrunn {
    --sno-pad: var(--s5);
    padding: 0 var(--sno-pad) var(--s5);
    background:
      linear-gradient(180deg, rgba(245,244,239,0.62) 0%, rgba(245,244,239,0.78) 40%, rgba(245,244,239,0.86) 75%, rgba(245,244,239,0.92) 100%),
      url('/bilder/raudalen.webp') center 8% / cover no-repeat; /* himmel, fjell og dal øverst i bildet */
  }
  .sno--bakgrunn .sno-bilde { display: none; }
  .sno--bakgrunn .sno-fane { margin-left: calc(-1 * var(--sno-pad)); }
  .sno--bakgrunn .sno-foto { position: absolute; right: var(--sno-pad); top: var(--s3); }
  .sno--bakgrunn .sno-kort { border-bottom-color: rgba(28,30,32,0.18); }

  /* Variant 2: panoramastripe øverst, fanen oppå bildet */
  .sno--stripe .sno-bilde { margin: 0; position: relative; aspect-ratio: 5 / 1; overflow: hidden; background: var(--flate); }
  .sno--stripe .sno-bilde img { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; display: block; }
  .sno--stripe .sno-fane { position: absolute; top: 0; left: 0; z-index: 1; }
  .sno--stripe .sno-foto { position: absolute; right: var(--s3); top: var(--s2); z-index: 1; color: var(--blyhvit); text-shadow: 0 0 6px rgba(0,0,0,0.45); }
  .sno--stripe .sno-topp { margin-top: var(--s1); }
  .sno[hidden] { display: none; }
  /* Fane → ingress under, venstrestilt, som blokkmønsteret ellers på siden */
  .sno-topp { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s4); }
  /* Neongul fane med sort tekst som henger ned fra den tykke streken (liten aksent, regel fra 9.11.) */
  .sno-fane {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--neon); color: var(--kull);
    padding: var(--s2) var(--s4) 7px;
    font-size: 15px; letter-spacing: 0.18em; line-height: 1.2;
  }
  .sno-antall { font-family: var(--overskrift); font-weight: 700; font-size: 26px; line-height: 1.2; letter-spacing: -0.01em; text-wrap: balance; }
  .sno-hode { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--s4); width: 100%; }
  .sno-under { font-size: 15px; line-height: 1.45; color: var(--tekst-2); margin-top: var(--s1); }
  .sno-piler { display: flex; gap: var(--s2); flex-shrink: 0; margin-left: auto; }
  .sno-piler[hidden] { display: none; }
  /* Sorte runde knapper med fet neongul pil (neongult på sort) */
  .sno-pil {
    width: 40px; height: 40px; border: 0; border-radius: 50%;
    background: var(--kull); color: var(--neon);
    cursor: pointer; display: grid; place-items: center; padding: 0;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .sno-pil:hover:not(:disabled) { transform: scale(1.06); }
  .sno-pil:focus-visible { outline: 2px solid var(--kull); outline-offset: 3px; }
  .sno-pil:disabled { opacity: 0.22; cursor: default; }
  .sno-under:empty { display: none; }

  /* Én rad som kan rulles sideveis: seks kort synlige på PC, tre på nettbrett, to på mobil */
  .sno-liste {
    list-style: none; margin: 0; padding: 0;
    display: flex; gap: var(--kol); overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .sno-liste::-webkit-scrollbar { display: none; }
  .sno-anlegg { flex: 0 0 calc((100% - 5 * var(--kol)) / 6); scroll-snap-align: start; }
  .sno-kort {
    display: flex; flex-direction: column; gap: var(--s2);
    height: 100%; padding: var(--s3) 0 var(--s4);
    border-top: 1px solid var(--linje);
  }
  .sno-kort:hover .sno-navn { color: var(--tekst-2); }
  .sno-status { display: inline-flex; align-items: center; gap: 7px; }
  .sno-prikk { width: 7px; height: 7px; border-radius: 50%; border: 1.5px solid var(--kull); box-sizing: border-box; flex-shrink: 0; }
  .sno-prikk--apen { background: var(--kull); }
  .sno-navn { font-family: var(--overskrift); font-weight: 700; font-size: 19px; line-height: 1.25; letter-spacing: -0.01em; text-wrap: balance; }
  .sno-linje { font-size: 15px; line-height: 1.45; color: var(--brodtekst); }
  .sno-region { margin-top: calc(-1 * var(--s1)); }

  .sno-kilde { display: flex; align-items: center; gap: var(--s4); }
  .sno-kilde p { font-size: 15px; line-height: 1.5; color: var(--tekst-2); }
  .sno-kilde p a { color: var(--tekst-2); text-decoration: underline; text-decoration-color: var(--linje); text-underline-offset: 3px; }
  .sno-kilde p a:hover { color: var(--kull); }
  .sno-logo { flex-shrink: 0; display: block; line-height: 0; }
  .sno-logo img { height: 32px; width: auto; }

  @media (max-width: 1100px) {
    .sno-anlegg { flex-basis: calc((100% - 2 * var(--kol)) / 3); }
  }
  @media (max-width: 600px) {
    /* På mobil: én rad som kan dras sideveis */
    .sno-liste {
      gap: var(--s5);
      margin: 0 calc(-1 * var(--sno-pad)); padding: 0 var(--sno-pad);
      scroll-padding-inline: var(--sno-pad);
    }
    .sno-anlegg { flex-basis: 44%; }
    .sno-piler { display: none; }
    .sno-kilde { align-items: flex-start; }
    .sno--bakgrunn { --sno-pad: var(--s4); }
    .sno--stripe .sno-bilde { aspect-ratio: 3 / 1; }
    .sno--bakgrunn .sno-foto { position: static; order: 10; }
  }
</style>
