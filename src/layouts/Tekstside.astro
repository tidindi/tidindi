---
// Enkel side for faste tekster: Om Tidindi, Redaksjonelle prinsipper, Personvern.
// Samme venstrekant og tekstbredde (7 kolonner) som brødteksten i artiklene.
import Base from './Base.astro';
import Hovedmeny from '../components/Hovedmeny.astro';
import Bunn from '../components/Bunn.astro';
interface Props { tittel: string; beskrivelse?: string }
const { tittel, beskrivelse } = Astro.props;
---
<Base tittel={tittel} beskrivelse={beskrivelse}>
  <Hovedmeny />
  <main class="wrap rutenett tekstside">
    <div class="k7 innhold">
      <h1>{tittel}</h1>
      <div class="tekst"><slot /></div>
    </div>
  </main>
  <Bunn />
</Base>

<style>
  .tekstside { padding-top: var(--s7); padding-bottom: var(--s8); }
  .innhold { display: flex; flex-direction: column; gap: var(--s5); }
  h1 { font-family: var(--overskrift); font-weight: 700; font-size: clamp(2.25rem, 5vw, 3.25rem); line-height: 1.08; letter-spacing: -0.01em; }
  .tekst { display: flex; flex-direction: column; gap: var(--s4); font-size: 1.125rem; line-height: 1.7; color: var(--brodtekst); }
  .tekst :global(h2) { font-family: var(--overskrift); font-size: 26px; line-height: 1.15; color: var(--kull); margin-top: var(--s3); }
</style>
