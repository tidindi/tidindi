---
// ARTIKKELMALEN – tradisjonell nyhetsartikkel.
import Base from '../../layouts/Base.astro';
import Hovedmeny from '../../components/Hovedmeny.astro';
import Bunn from '../../components/Bunn.astro';
import Bilde from '../../components/Bilde.astro';
import Seksjonsmerke from '../../components/Seksjonsmerke.astro';
import { artikler, artikkelUrl, type Artikkel } from '../../data/testinnhold';
import { seksjonsnavn } from '../../data/seksjoner';
import { datoOgTid, klokkeslett } from '../../data/format';

export function getStaticPaths() {
  return artikler.map((a) => ({ params: { seksjon: a.seksjon, slug: a.slug }, props: { artikkel: a } }));
}

const { artikkel: a } = Astro.props as { artikkel: Artikkel };
const merFra = artikler.filter((x) => x.seksjon === a.seksjon && x.slug !== a.slug).slice(0, 4);
const lesOgsa = artikler.filter((x) => x.slug !== a.slug && x.seksjon !== a.seksjon).slice(0, 3);
---
<Base tittel={a.tittel} beskrivelse={a.ingress} bilde={a.bilde?.src} type="article">
  <Hovedmeny aktiv={a.seksjon} />

  <main>
    <article>
      <header class="wrap art-hode">
        <div class="art-merke">
          <a href={`/${a.seksjon}/`}><Seksjonsmerke seksjon={a.seksjon} storrelse="stor" /></a>
          {a.sted && <span class="meta">{a.sted}</span>}
        </div>
        <h1 class="art-tittel">{a.tittel}</h1>
        <p class="art-ingress">{a.ingress}</p>
        <div class="art-byline">
          <span>{a.skribent}</span>
          <span class="meta">
            Publisert <time datetime={a.publisert}>{datoOgTid(a.publisert)}</time>
            {a.oppdatert && <> · Oppdatert <time datetime={a.oppdatert}>{klokkeslett(a.oppdatert)}</time></>}
          </span>
        </div>
      </header>

      <figure class="wrap art-bilde">
        <Bilde src={a.bilde?.src} alt={a.bilde?.alt} format="16-8" laster="eager" />
        {(a.bilde?.tekst || a.bilde?.kreditering) && (
          <figcaption>{a.bilde?.tekst} {a.bilde?.kreditering && <span class="meta">Foto: {a.bilde.kreditering}</span>}</figcaption>
        )}
      </figure>

      <div class="wrap art-kropp">
        <div class="art-tekst">
          {a.brodtekst.map((b) => {
            if (b.type === 'avsnitt') return <p>{b.tekst}</p>;
            if (b.type === 'mellomtittel') return <h2 class="art-mellomtittel">{b.tekst}</h2>;
            if (b.type === 'sitat') return (
              <blockquote class="art-sitat">
                <p>«{b.tekst}»</p>
                <cite class="etikett">{b.kilde}</cite>
              </blockquote>
            );
            if (b.type === 'fakta') return (
              <aside class="art-fakta" aria-label={b.tittel ?? 'Fakta'}>
                <div class="etikett seksjon-merke"><span class="rombe" aria-hidden="true"></span>{b.tittel ?? 'Fakta'}</div>
                <ul>{b.punkter.map((p) => <li>{p}</li>)}</ul>
              </aside>
            );
          })}
          {a.kilde && <p class="meta art-kilde">Kilde: {a.kilde}</p>}
        </div>

        <aside class="art-side">
          {merFra.length > 0 && (
            <div class="mer-fra strek-tykk">
              <h2 class="etikett mer-fra-tittel">Mer fra {seksjonsnavn(a.seksjon)}</h2>
              <ul>{merFra.map((x) => <li><a href={artikkelUrl(x)} class="h-siste">{x.tittel}</a></li>)}</ul>
            </div>
          )}
          <div class="mb-boks">
            <div class="etikett seksjon-merke"><span class="rombe" aria-hidden="true"></span>Tidindi morgenbrief</div>
            <p>Ti saker fra ti medier. Hver hverdag, før dagen begynner.</p>
            <a class="knapp-sort" href="/morgenbrief/">Se mer her</a>
          </div>
        </aside>
      </div>
    </article>

    {lesOgsa.length > 0 && (
      <section class="les-ogsa strek-tykk" aria-labelledby="les-ogsa-tittel">
        <div class="wrap">
          <h2 id="les-ogsa-tittel" class="etikett les-ogsa-tittel">Les også</h2>
          <div class="les-ogsa-grid">
            {lesOgsa.map((x) => (
              <a href={artikkelUrl(x)} class="les-ogsa-sak">
                <Seksjonsmerke seksjon={x.seksjon} />
                <span class="h-stor">{x.tittel}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Bunn />
</Base>

<style>
  .art-hode { max-width: 820px; padding-top: 56px; padding-bottom: 32px; display: flex; flex-direction: column; gap: 20px; }
  .art-merke { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; }
  .art-tittel { font-family: var(--overskrift); font-weight: 700; font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: 1.06; letter-spacing: -0.01em; }
  .art-ingress { font-size: 1.375rem; line-height: 1.5; color: var(--brodtekst); }
  .art-byline {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px 24px;
    padding: 14px 0; border-top: 1px solid var(--kull); border-bottom: 1px solid var(--linje);
    font-family: var(--etikett); font-size: 14px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
  }
  .art-bilde { max-width: 1152px; display: flex; flex-direction: column; gap: 10px; }
  .art-bilde figcaption { font-size: 15px; line-height: 1.45; color: var(--tekst-2); }

  .art-kropp { max-width: 1152px; padding-top: 48px; padding-bottom: 64px; display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start; }
  .art-tekst { flex: 999 1 600px; min-width: 0; max-width: 680px; display: flex; flex-direction: column; gap: 22px; font-size: 1.1875rem; line-height: 1.7; }
  .art-mellomtittel { margin-top: 14px; font-family: var(--overskrift); font-weight: 700; font-size: 27px; line-height: 1.2; letter-spacing: -0.01em; }
  .art-sitat { margin: 10px 0; padding: 24px 0 22px; border-top: 3px solid var(--kull); border-bottom: 1px solid var(--kull); display: flex; flex-direction: column; gap: 14px; }
  .art-sitat p { font-family: var(--overskrift); font-style: italic; font-size: clamp(1.5rem, 2.6vw, 1.875rem); line-height: 1.3; }
  .art-sitat cite { font-style: normal; }
  .art-fakta { margin: 10px 0; background: var(--flate); padding: 24px 26px; display: flex; flex-direction: column; gap: 12px; font-size: 17px; line-height: 1.5; }
  .art-fakta ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; }
  .art-kilde { margin-top: 8px; padding-top: 16px; border-top: 1px solid var(--linje); font-size: 14px; letter-spacing: 0.08em; }

  .art-side { flex: 1 1 260px; min-width: 0; display: flex; flex-direction: column; gap: 40px; }
  .mer-fra-tittel { padding: 14px 0 4px; font-size: 15px; letter-spacing: 0.18em; }
  .mer-fra ul { list-style: none; margin: 0; padding: 0; }
  .mer-fra li a { display: block; padding: 14px 0; border-bottom: 1px solid var(--linje); }
  .mb-boks { background: var(--neon); padding: 24px; display: flex; flex-direction: column; gap: 14px; }
  .mb-boks p { font-size: 18px; line-height: 1.4; }
  .mb-boks .knapp-sort { align-self: flex-start; }

  .les-ogsa .wrap { padding-top: 18px; padding-bottom: 64px; }
  .les-ogsa-tittel { font-size: 16px; letter-spacing: 0.18em; }
  .les-ogsa-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); column-gap: 40px; }
  .les-ogsa-sak { display: flex; flex-direction: column; gap: 10px; padding: 18px 0; border-bottom: 1px solid var(--linje); }
</style>
