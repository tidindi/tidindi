---
// ARTIKKELMALEN – tradisjonell nyhetsartikkel.
// Rutenett: hode 8 kolonner, bilde 12, brødtekst 7 (ca. 65–70 tegn per linje), sidespalte kolonne 9–12.
// Venstrekanten er den samme for hode, bilde og tekst.
import Base from '../../layouts/Base.astro';
import Hovedmeny from '../../components/Hovedmeny.astro';
import Bunn from '../../components/Bunn.astro';
import Bilde from '../../components/Bilde.astro';
import Seksjonsmerke from '../../components/Seksjonsmerke.astro';
import { artikler, artikkelUrl, type Artikkel } from '../../data/testinnhold';
import { seksjonsnavn } from '../../data/seksjoner';
import { datoOgTid, klokkeslett } from '../../data/format';

export function getStaticPaths() {
  return artikler.map((a) => ({ params: { seksjon: a.seksjon, slug: a.slug }, props: { artikkel: a } }));
}

const { artikkel: a } = Astro.props as { artikkel: Artikkel };
const merFra = artikler.filter((x) => x.seksjon === a.seksjon && x.slug !== a.slug).slice(0, 4);
const lesOgsa = artikler.filter((x) => x.slug !== a.slug && x.seksjon !== a.seksjon).slice(0, 3);
---
<Base tittel={a.tittel} beskrivelse={a.ingress} bilde={a.bilde?.src} type="article">
  <Hovedmeny aktiv={a.seksjon} />

  <main class="wrap artikkel">
    <article class="rutenett art-rad">
      <header class="k8 art-hode">
        <div class="art-merke">
          <a href={`/${a.seksjon}/`}><Seksjonsmerke seksjon={a.seksjon} storrelse="stor" /></a>
          {a.sted && <span class="meta">{a.sted}</span>}
        </div>
        <h1 class="art-tittel">{a.tittel}</h1>
        <p class="art-ingress">{a.ingress}</p>
        <div class="art-byline">
          <span>{a.skribent}</span>
          <span class="meta">
            Publisert <time datetime={a.publisert}>{datoOgTid(a.publisert)}</time>
            {a.oppdatert && <> · Oppdatert <time datetime={a.oppdatert}>{klokkeslett(a.oppdatert)}</time></>}
          </span>
        </div>
      </header>

      <figure class="k12 art-bilde">
        <Bilde src={a.bilde?.src} alt={a.bilde?.alt} format="16-8" laster="eager" />
        {(a.bilde?.tekst || a.bilde?.kreditering) && (
          <figcaption>{a.bilde?.tekst} {a.bilde?.kreditering && <span class="meta">Foto: {a.bilde.kreditering}</span>}</figcaption>
        )}
      </figure>

      <div class="k7 art-tekst">
        {a.brodtekst.map((b) => {
          if (b.type === 'avsnitt') return <p>{b.tekst}</p>;
          if (b.type === 'mellomtittel') return <h2 class="h-stor art-mellomtittel">{b.tekst}</h2>;
          if (b.type === 'sitat') return (
            <blockquote class="art-sitat">
              <p>«{b.tekst}»</p>
              <cite class="etikett">{b.kilde}</cite>
            </blockquote>
          );
          if (b.type === 'fakta') return (
            <aside class="art-fakta" aria-label={b.tittel ?? 'Fakta'}>
              <div class="etikett seksjon-merke"><span class="rombe" aria-hidden="true"></span>{b.tittel ?? 'Fakta'}</div>
              <ul>{b.punkter.map((p) => <li>{p}</li>)}</ul>
            </aside>
          );
        })}
        {a.kilde && <p class="meta art-kilde">Kilde: {a.kilde}</p>}
      </div>

      <aside class="fra9 art-side">
        {merFra.length > 0 && (
          <div class="strek-tykk">
            <h2 class="etikett blokk-etikett">Mer fra {seksjonsnavn(a.seksjon)}</h2>
            <ul class="mer-fra">{merFra.map((x) => <li><a href={artikkelUrl(x)} class="h-siste">{x.tittel}</a></li>)}</ul>
          </div>
        )}
        <div class="mb-boks">
          <div class="etikett seksjon-merke"><span class="rombe" aria-hidden="true"></span>Tidindi morgenbrief</div>
          <p>Ti saker fra ti medier. Hver hverdag, før dagen begynner.</p>
          <a class="knapp-sort" href="/morgenbrief/">Se mer her</a>
        </div>
      </aside>
    </article>

    {lesOgsa.length > 0 && (
      <section class="strek-tykk les-ogsa" aria-labelledby="les-ogsa-tittel">
        <h2 id="les-ogsa-tittel" class="etikett blokk-etikett">Les også</h2>
        <div class="rutenett">
          {lesOgsa.map((x) => (
            <a href={artikkelUrl(x)} class="k4 kort les-ogsa-sak">
              <Seksjonsmerke seksjon={x.seksjon} />
              <span class="h-stor">{x.tittel}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>

  <Bunn />
</Base>

<style>
  .artikkel { padding-bottom: var(--s8); }
  .art-rad { row-gap: var(--s7); padding-top: var(--s7); padding-bottom: var(--s8); align-items: start; }

  .art-hode { display: flex; flex-direction: column; gap: var(--s5); }
  .art-merke { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2) var(--s4); }
  .art-tittel { font-family: var(--overskrift); font-weight: 700; font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: 1.06; letter-spacing: -0.01em; }
  .art-ingress { font-size: 1.375rem; line-height: 1.5; color: var(--brodtekst); }
  .art-byline {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s2) var(--s5);
    padding: var(--s3) 0; border-top: 1px solid var(--kull); border-bottom: 1px solid var(--linje);
    font-family: var(--etikett); font-size: 14px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
  }

  .art-bilde { display: flex; flex-direction: column; gap: var(--s2); margin-top: calc(-1 * var(--s3)); }
  .art-bilde figcaption { font-size: 15px; line-height: 1.45; color: var(--tekst-2); }

  .art-tekst { display: flex; flex-direction: column; gap: var(--s5); font-size: 1.1875rem; line-height: 1.7; }
  .art-mellomtittel { margin-top: var(--s3); }
  .art-sitat, .art-fakta { margin: var(--s2) 0; }
  .art-sitat { padding: var(--s5) 0; border-top: 3px solid var(--kull); border-bottom: 1px solid var(--kull); display: flex; flex-direction: column; gap: var(--s3); }
  .art-sitat p { font-family: var(--overskrift); font-style: italic; font-size: clamp(1.5rem, 2.6vw, 1.875rem); line-height: 1.3; }
  .art-sitat cite { font-style: normal; }
  .art-fakta { background: var(--flate); padding: var(--s5); display: flex; flex-direction: column; gap: var(--s3); font-size: 17px; line-height: 1.5; }
  .art-fakta ul { margin: 0; padding-left: var(--s5); display: flex; flex-direction: column; gap: var(--s2); }
  .art-kilde { padding-top: var(--s4); border-top: 1px solid var(--linje); font-size: 14px; letter-spacing: 0.08em; }

  .art-side { display: flex; flex-direction: column; gap: var(--s7); }
  .mer-fra { list-style: none; margin: 0; padding: 0; }
  .mer-fra li a { display: block; padding: var(--s4) 0; border-bottom: 1px solid var(--linje); }
  .mb-boks { background: var(--neon); padding: var(--s5); display: flex; flex-direction: column; gap: var(--s4); align-items: flex-start; }
  .mb-boks p { font-size: 18px; line-height: 1.45; }

  .les-ogsa-sak { padding: var(--s5) 0; border-bottom: 1px solid var(--linje); }

  @media (max-width: 900px) {
    .art-bilde { margin-top: 0; }
  }
</style>
