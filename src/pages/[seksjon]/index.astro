---
// SEKSJONSSIDE – forslag (ikke tegnet i designet ennå): nyeste saker i seksjonen.
// Rutenett: første sak bilde 7 + tekst 5; listen 8 kolonner (samme bredde som artikkelhodet).
import Base from '../../layouts/Base.astro';
import Hovedmeny from '../../components/Hovedmeny.astro';
import Bunn from '../../components/Bunn.astro';
import Bilde from '../../components/Bilde.astro';
import { seksjoner, seksjonsnavn } from '../../data/seksjoner';
import { hentArtikler, artikkelUrl } from '../../data/innhold';
import { sisteTid } from '../../data/format';

export function getStaticPaths() {
  return seksjoner.map((s) => ({ params: { seksjon: s.slug } }));
}

const { seksjon } = Astro.params as { seksjon: string };
const saker = (await hentArtikler()).filter((a) => a.seksjon === seksjon); // nyeste først
const [forste, ...resten] = saker;
---
<Base tittel={seksjonsnavn(seksjon)} beskrivelse={`Nyheter fra ${seksjonsnavn(seksjon).toLowerCase()} i Tidindi.`}>
  <Hovedmeny aktiv={seksjon} />
  <main class="wrap seksjonsside">
    <h1 class="seksjon-tittel">{seksjonsnavn(seksjon)}</h1>

    {forste ? (
      <>
        <article class="rutenett strek-tykk forste">
          <a href={artikkelUrl(forste)} class="k7" tabindex="-1" aria-hidden="true"><Bilde bilde={forste.bilde} alt="" format="16-9" laster="eager" storrelser="(max-width: 900px) 100vw, 690px" /></a>
          <div class="k5 kort forste-tekst">
            <span class="meta"><time data-siste datetime={forste.publisert}>{sisteTid(forste.publisert)}</time></span>
            <h2 class="h-hoved"><a href={artikkelUrl(forste)}>{forste.tittel}</a></h2>
            <p class="ingress">{forste.ingress}</p>
          </div>
        </article>
        <div class="rutenett">
          <ul class="k8 liste">
            {resten.map((a) => (
              <li>
                <a href={artikkelUrl(a)} class="kort">
                  <span class="meta"><time data-siste datetime={a.publisert}>{sisteTid(a.publisert)}</time></span>
                  <span class="h-stor">{a.tittel}</span>
                  <span class="liste-ingress">{a.ingress}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </>
    ) : (
      <p class="tom">Det er ingen saker i denne seksjonen ennå.</p>
    )}
  </main>
  <Bunn />
</Base>

<style>
  .seksjonsside { padding-top: var(--blokk); padding-bottom: var(--s8); display: flex; flex-direction: column; gap: var(--s6); }
  .seksjon-tittel { font-family: var(--etikett); font-weight: 700; font-size: clamp(2.5rem, 6vw, 4rem); letter-spacing: 0.06em; text-transform: uppercase; line-height: 1; }
  .forste { padding-top: var(--s5); row-gap: var(--s5); align-items: start; }
  .forste-tekst { gap: var(--s4); }
  .forste-tekst .h-hoved { font-size: clamp(2rem, 3.4vw, 2.875rem); }
  .liste { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--kull); }
  .liste li a { padding: var(--s5) 0; border-bottom: 1px solid var(--linje); }
  .liste-ingress { font-size: 17px; color: var(--brodtekst); }
  .tom { color: var(--tekst-2); }
</style>
