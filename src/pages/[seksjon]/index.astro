---
// SEKSJONSSIDE – forslag (ikke tegnet i designet ennå): nyeste saker i seksjonen.
import Base from '../../layouts/Base.astro';
import Hovedmeny from '../../components/Hovedmeny.astro';
import Bunn from '../../components/Bunn.astro';
import Bilde from '../../components/Bilde.astro';
import { seksjoner, seksjonsnavn } from '../../data/seksjoner';
import { artikler, artikkelUrl } from '../../data/testinnhold';
import { sisteTid } from '../../data/format';

export function getStaticPaths() {
  return seksjoner.map((s) => ({ params: { seksjon: s.slug } }));
}

const { seksjon } = Astro.params as { seksjon: string };
const saker = artikler.filter((a) => a.seksjon === seksjon).sort((a, b) => b.publisert.localeCompare(a.publisert));
const [forste, ...resten] = saker;
---
<Base tittel={seksjonsnavn(seksjon)} beskrivelse={`Nyheter fra ${seksjonsnavn(seksjon).toLowerCase()} i Tidindi.`}>
  <Hovedmeny aktiv={seksjon} />
  <main class="wrap seksjonsside">
    <h1 class="seksjon-tittel">{seksjonsnavn(seksjon)}</h1>

    {forste ? (
      <>
        <article class="forste strek-tykk">
          <a href={artikkelUrl(forste)}><Bilde src={forste.bilde?.src} alt={forste.bilde?.alt} format="16-9" laster="eager" /></a>
          <div class="forste-tekst">
            <span class="meta"><time datetime={forste.publisert}>{sisteTid(forste.publisert)}</time></span>
            <h2 class="h-hoved"><a href={artikkelUrl(forste)}>{forste.tittel}</a></h2>
            <p class="ingress">{forste.ingress}</p>
          </div>
        </article>
        <ul class="liste">
          {resten.map((a) => (
            <li>
              <a href={artikkelUrl(a)}>
                <span class="meta"><time datetime={a.publisert}>{sisteTid(a.publisert)}</time></span>
                <span class="h-stor">{a.tittel}</span>
                <span class="liste-ingress">{a.ingress}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <p class="tom">Det er ingen saker i denne seksjonen ennå.</p>
    )}
  </main>
  <Bunn />
</Base>

<style>
  .seksjonsside { padding-top: 40px; padding-bottom: 64px; display: flex; flex-direction: column; gap: 28px; }
  .seksjon-tittel { font-family: var(--etikett); font-weight: 700; font-size: clamp(2.5rem, 6vw, 4rem); letter-spacing: 0.06em; text-transform: uppercase; line-height: 1; }
  .forste { padding-top: 28px; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 32px; align-items: start; }
  .forste-tekst { display: flex; flex-direction: column; gap: 14px; }
  .liste { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--kull); }
  .liste li a { display: flex; flex-direction: column; gap: 8px; padding: 22px 0; border-bottom: 1px solid var(--linje); }
  .liste-ingress { font-size: 17px; color: var(--brodtekst); }
  .tom { color: var(--tekst-2); }
  @media (max-width: 800px) { .forste { grid-template-columns: minmax(0, 1fr); } }
</style>
