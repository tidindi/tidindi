---
// FORSIDEN – plasseringene styres redaksjonelt (forsideoppsettet), «Siste» fylles automatisk.
import Base from '../layouts/Base.astro';
import Topplinje from '../components/Topplinje.astro';
import Masthead from '../components/Masthead.astro';
import Bunn from '../components/Bunn.astro';
import Bilde from '../components/Bilde.astro';
import Seksjonsmerke from '../components/Seksjonsmerke.astro';
import MorgenbriefRamme from '../components/MorgenbriefRamme.astro';
import { forside, finnArtikkel, sisteArtikler, artikkelUrl, type Artikkel } from '../data/testinnhold';
import { sisteTid } from '../data/format';
import { seksjonsnavn } from '../data/seksjoner';

const hent = (slug: string) => finnArtikkel(slug) as Artikkel;
const hovedsak = hent(forside.hovedsak);
const treSaker = forside.treSaker.map(hent);
const bildesaker = forside.bildesaker.map(hent);
const siste = sisteArtikler(5);
---
<Base>
  <Topplinje />
  <Masthead />

  <main class="wrap forside">
    <section class="topp">
      <article class="hovedsak">
        <a href={artikkelUrl(hovedsak)} class="hovedsak-bilde">
          <Bilde src={hovedsak.bilde?.src} alt={hovedsak.bilde?.alt} format="16-9" laster="eager" />
        </a>
        {hovedsak.bilde?.kreditering && <p class="meta kreditering">Foto: {hovedsak.bilde.kreditering}</p>}
        <Seksjonsmerke seksjon={hovedsak.seksjon} storrelse="stor" />
        <h1 class="h-hoved"><a href={artikkelUrl(hovedsak)}>{hovedsak.tittel}</a></h1>
        <p class="ingress">{hovedsak.ingress}</p>
      </article>

      <aside class="siste strek-tykk" aria-labelledby="siste-tittel">
        <h2 id="siste-tittel" class="etikett siste-tittel">Siste</h2>
        <ul>
          {siste.map((a) => (
            <li>
              <a href={artikkelUrl(a)}>
                <span class="meta"><time datetime={a.publisert}>{sisteTid(a.publisert)}</time> · {seksjonsnavn(a.seksjon)}</span>
                <span class="h-siste">{a.tittel}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </section>

    <section class="tre strek-tykk" aria-label="Flere saker">
      {treSaker.map((a) => (
        <article class="tre-sak">
          <Seksjonsmerke seksjon={a.seksjon} />
          <h2 class="h-stor"><a href={artikkelUrl(a)}>{a.tittel}</a></h2>
          <p class="tre-ingress">{a.ingress}</p>
        </article>
      ))}
    </section>

    <MorgenbriefRamme {...forside.morgenbrief} />

    <section class="bildesaker" aria-label="Bildesaker">
      {bildesaker.map((a) => (
        <article class="bildesak">
          <a href={artikkelUrl(a)} tabindex="-1" aria-hidden="true"><Bilde src={a.bilde?.src} alt="" format="3-2" /></a>
          <Seksjonsmerke seksjon={a.seksjon} />
          <h3 class="h-mellom"><a href={artikkelUrl(a)}>{a.tittel}</a></h3>
        </article>
      ))}
    </section>
  </main>

  <Bunn />
</Base>

<style>
  .forside { padding-top: 40px; padding-bottom: 48px; display: flex; flex-direction: column; gap: 48px; }

  .topp { display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-start; }
  .hovedsak { flex: 999 1 600px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  .hovedsak .ingress { max-width: 720px; }
  .kreditering { font-size: 12px; margin-top: -10px; }

  .siste { flex: 1 1 300px; min-width: 0; }
  .siste-tittel { padding: 14px 0 6px; font-size: 16px; letter-spacing: 0.18em; }
  .siste ul { list-style: none; margin: 0; padding: 0; }
  .siste li a { display: flex; flex-direction: column; gap: 6px; padding: 16px 0; border-bottom: 1px solid var(--linje); }

  .tre { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); column-gap: 40px; padding-top: 6px; }
  .tre-sak { display: flex; flex-direction: column; gap: 12px; padding: 22px 0 28px; border-bottom: 1px solid var(--linje); }
  .tre-ingress { font-size: 17px; line-height: 1.5; color: var(--brodtekst); }

  .bildesaker { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0 32px; }
  .bildesak { display: flex; flex-direction: column; gap: 12px; padding-bottom: 28px; }
</style>
